{
  "name": "img-gen-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:preview": "vite --mode preview",
    "check": "tsc --noEmit && node scripts/check-scripts.mjs",
    "build": "tsc --noEmit && vite build",
    "build:server": "npm run build && node scripts/sync-server.mjs",
    "preview": "vite preview",
    "preview:check": "node scripts/preview-check.mjs",
    "verify:frontend": "npm run check && npm run build && npm run preview:check",
    "verify": "npm run verify:frontend"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
