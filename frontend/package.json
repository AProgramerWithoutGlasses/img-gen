{
  "name": "img-gen-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:preview": "vite --mode preview",
    "check": "tsc --noEmit && node scripts/check-scripts.mjs",
    "build": "node scripts/build.mjs",
    "sync:server": "node scripts/sync-server.mjs",
    "build:server": "npm run build && npm run sync:server",
    "preview": "vite preview",
    "preview:check": "node tests/e2e/preview-check.mjs",
    "auth-gallery:check": "node tests/e2e/auth-gallery-check.mjs",
    "base-images:check": "node tests/e2e/base-images-check.mjs",
    "performance:check": "node tests/e2e/performance-check.mjs",
    "verify:frontend": "node scripts/check-scripts.mjs && npm run build && npm run preview:check && npm run auth-gallery:check && npm run base-images:check && npm run performance:check",
    "verify": "npm run verify:frontend"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yet-another-react-lightbox": "3.33.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
