{
  "name": "ui-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit && node scripts/check-scripts.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:check": "node scripts/preview-check.mjs",
    "design:open": "node scripts/figcraft.mjs open",
    "design:status": "node scripts/figcraft.mjs status",
    "design:audit": "node scripts/figcraft.mjs audit",
    "design:export": "node scripts/figcraft.mjs export",
    "design:snapshot": "node scripts/figcraft.mjs snapshot",
    "design:batch": "node scripts/figcraft.mjs batch",
    "design:smoke": "node scripts/figcraft-smoke.mjs",
    "design:verify": "npm run design:audit && npm run design:export",
    "verify:frontend": "npm run check && npm run build && npm run preview:check",
    "verify": "npm run verify:frontend && npm run design:verify"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
