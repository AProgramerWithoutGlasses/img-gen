{
  "name": "ui-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit && node --check scripts/preview-check.mjs && node --check scripts/design-audit.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:check": "node scripts/preview-check.mjs",
    "design:audit": "node scripts/design-audit.mjs",
    "verify": "npm run check && npm run build && npm run preview:check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@open-pencil/core": "0.16.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
