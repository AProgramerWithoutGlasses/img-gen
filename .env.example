# Copy to .env; the Go server loads it automatically. Never commit .env.
LISTEN_ADDR=127.0.0.1:8080
MYSQL_DSN=imggen:change-me@tcp(127.0.0.1:3306)/imggen?charset=utf8mb4&parseTime=true&loc=UTC
QISO_BASE_URL=https://api.qiso.io
QISO_API_KEY=
# Bootstrap administrator only when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Legacy APP_PASSWORD is used only if ADMIN_PASSWORD is unset.
# Set true behind an HTTPS reverse proxy; keep false for localhost HTTP.
COOKIE_SECURE=false

# Docker Compose only. Use random passwords; DSN passwords must not contain @.
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-this-root-password
